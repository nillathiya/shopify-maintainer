# Everything here can also be set from the Settings screen in the app.
# Values in this file win over values saved in the app.

# Public store address (custom domain is fine).
STOREFRONT_URL=
# Only if the storefront is password protected.
STOREFRONT_PASSWORD=

# ── Optional: read-only admin access for the deeper theme scan ──
# Your store's permanent .myshopify.com domain (found automatically by the first scan).
SHOPIFY_SHOP=
# A Dev Dashboard app installed on your store with read_themes + read_products.
# The app exchanges these for a short-lived token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or an existing admin-created custom app token (shpat_...).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# ── App ──
PORT=4747
DATA_DIR=./data
# Optional: use an existing Chromium/Chrome instead of `npm run setup:browser`.
CHROMIUM_PATH=
